<div class="form-group my-3">
    <button type="button" class="btn btn-outline-success" id="ajouter-input-document">Ajouter un document +</button>
</div>
<div id="inputs-container-document"></div>

<script>
$(document).ready(function() {
    var counter = 0;
    var visualcounter = 1

 $("#ajouter-input-document").click(function() {
        var newInputs = $("<div>", {
            class: "form-group mb-3"
        }).append($("<label>", {
            for: "title" + counter,
            class: "form-label",
            text: "Titre du document " + visualcounter
        })).append($("<input>", {
            type: "text",
            name: "document[" + counter + "][title]",
            class: "form-control",
            id: "title" + counter
        })).append($("<label>", {
            for: "year" + counter,
            class: "form-label p-2",
            text: "Année du document " + visualcounter
        })).append($("<input>", {
            type: "date",
            name: "document[" + counter + "][year]",
            class: "form-control",
            id: "year" + counter
        })).append($("<label>", {
            for: "type" + counter,
            class: "form-label",
            text: "Type de document" + visualcounter
        })).append($("<select>", {
            name: "document[" + counter + "][type]",
            class: "form-control",
            id: "type" + counter,
        }).append($("<option>", {
            value: "",
            text: "Sélectionnez un type de document",
            disabled: true,
            selected: true
        })).append($("<option>", {
            value: "PDF",
            text: "PDF"
        })).append($("<option>", {
            value: "DOC",
            text: "DOC"
        })).append($("<option>", {
            value: "PPT",
            text: "PPT"
        }))).append($("<label>", {
            for: "source" + counter,
            class: "form-label",
            text: "Source du document " + visualcounter
        })).append($("<input>", {
            type: "text",
            name: "document[" + counter + "][source]",
            class: "form-control",
            id: "source" + counter
        })).append($("<label>", {
            for: "path" + counter,
            class: "form-label",
            text: "Fichier " + visualcounter
        })).append($("<input>", {
            type: "file",
            name: "document[" + counter + "][file][path]",
            class: "form-control p-2",
            id: "path" + counter
        })).append($("<label>", {
            for: "titlefile" + counter,
            class: "form-label",
            text: "Titre du fichier " + visualcounter
        })).append($("<input>", {
            type: "text",
            name: "document[" + counter + "][file][title]",
            class: "form-control",
            id: "titlefile" + counter
        })).append($("<hr>"));

        $("#inputs-container-document").append(newInputs);
        counter++;
        visualcounter++;
    });
});
</script>
